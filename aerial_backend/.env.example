AERIAL_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aerial_db

AERIAL_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 机器人开了签名校验才填，不开就留空
AERIAL_FEISHU_WEBHOOK_SECRET=

AERIAL_VALIDATION_FAIL_ESCALATION_THRESHOLD=3
AERIAL_ESCALATION_USERNAMES=["ziyu","quanwei"]

# 扫盘根目录，也可以在触发扫盘接口时临时指定
# 另一个常用根目录示例: /mnt/nas/ADSafety/ADSafety/Aerial_Raw_Videos
AERIAL_SCAN_ROOTS=["/mnt/Expansion/data"]

# 阿里云PDS自动下载，见 services/aliyun_sync.py
# 留空默认用 extern/pds-drive-sync/.tools/aliyun
AERIAL_ALIYUN_CLI_BINARY=
AERIAL_ALIYUN_SPACES=["personal","team","enterprise"]
# 生产环境改成真实NAS路径，比如 /mnt/Expansion2/Aerial_Raw_Videos
AERIAL_ALIYUN_DOWNLOAD_DIR=data
AERIAL_ALIYUN_MIN_FREE_GB=200
# 6小时一次心跳，8次=2天无变化才判定上传完成
AERIAL_ALIYUN_STABILITY_SCANS_REQUIRED=8
AERIAL_ALIYUN_DOWNLOAD_TIMEOUT_SECONDS=1800
