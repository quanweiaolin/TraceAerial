AERIAL_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aerial_db
AERIAL_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
AERIAL_FEISHU_WEBHOOK_SECRET= # 机器人开了签名校验才填，不开就留空
AERIAL_VALIDATION_FAIL_ESCALATION_THRESHOLD=3
AERIAL_ESCALATION_USERNAMES=["ziyu","quanwei"]
AERIAL_SCAN_ROOTS=["/mnt/Expansion/data"] # /mnt/nas/ADSafety/ADSafety/Aerial_Raw_Videos
# VRU检测QA用，模型文件放checkpoints/目录(已gitignore，不进仓库)；
# 相对路径是相对于运行uvicorn时的工作目录(aerial_backend/)算的
AERIAL_VRU_MODEL_PATH=checkpoints/best_vru_universal.pt
AERIAL_VRU_MODEL_NAME=vru_universal
AERIAL_VRU_MODEL_VERSION=v1
# 检测结果(Test/目录、批次清单)存放根目录，正式环境用NAS路径；
# NAS写权限没弄好之前可以先指向本地测试目录(必须写绝对路径！)，比如：
# AERIAL_VRU_PROCESSING_ROOT=/home/xxx/Workspace/TraceAerial/data
AERIAL_VRU_PROCESSING_ROOT=/mnt/nas/ADSafety/ADSafety/Aerial_Processing_Data
